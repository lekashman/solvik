    language dflt;
            lookup MarkToMark17;

} mkmk;

feature mkmk {
    script latn;
    language dflt;
            lookup MarkToMark17;

} mkmk;

feature mkmk {
    script latn;
    language CAT;
            lookup MarkToMark17;

} mkmk;

feature mkmk {
    script latn;
    language MOL;
            lookup MarkToMark17;

} mkmk;

feature mkmk {
    script latn;
    language ROM;
            lookup MarkToMark17;

} mkmk;

# Mark positioning for Cyrillic and Greek, using the same lookups as the default script.
feature mark {
    script cyrl;
    language dflt;
            lookup MarkToBase7;
} mark;
feature mark {
    script cyrl;
    language dflt;
            lookup MarkToBase9;
} mark;
feature mark {
    script cyrl;
    language dflt;
            lookup MarkToBase11;
} mark;
feature mark {
    script cyrl;
    language dflt;
            lookup MarkToBase13;
} mark;
feature mark {
    script cyrl;
    language dflt;
            lookup MarkToBase15;
} mark;
feature mkmk {
    script cyrl;
    language dflt;
            lookup MarkToMark17;
} mkmk;
feature mark {
    script grek;
    language dflt;
            lookup MarkToBase7;
} mark;
feature mark {
    script grek;
    language dflt;
            lookup MarkToBase9;
} mark;
feature mark {
    script grek;
    language dflt;
            lookup MarkToBase11;
} mark;
feature mark {
    script grek;
    language dflt;
            lookup MarkToBase13;
} mark;
feature mark {
    script grek;
    language dflt;
            lookup MarkToBase15;
} mark;
feature mkmk {
    script grek;
    language dflt;
            lookup MarkToMark17;
} mkmk;

# Extra kerning for pairs that sat closer than 8% of the stem width, most of them touching.
# The values add to the kerning in the lookups above.
lookup CollisionKern {
    lookupflag 0;
    pos backslash longs 37;
    pos k longs 14;
    pos kgreenlandic longs 9;
    pos longs icircumflex 48;
    pos longs jcircumflex 45;
    pos longs v 8;
    pos longs y 10;
    pos longs yacute 10;
    pos longs ycircumflex 10;
    pos longs ydieresis 10;
    pos underscore longs 7;
    pos uni00B5 longs 42;
    pos uni00B5 underscore 30;
    pos uni0137 longs 14;
} CollisionKern;
feature kern {
    script DFLT;
    language dflt;
            lookup CollisionKern;
} kern;
feature kern {
    script cyrl;
    language dflt;
            lookup CollisionKern;
} kern;
feature kern {
    script grek;
    language dflt;
            lookup CollisionKern;
} kern;
feature kern {
    script latn;
    language dflt;
            lookup CollisionKern;
} kern;
feature kern {
    script latn;
    language CAT;
            lookup CollisionKern;
} kern;
feature kern {
    script latn;
    language MOL;
            lookup CollisionKern;
} kern;
feature kern {
    script latn;
    language ROM;
            lookup CollisionKern;
} kern;
