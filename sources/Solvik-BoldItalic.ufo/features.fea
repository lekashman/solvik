# Extra kerning for pairs that sat closer than 8% of the stem width, most of them touching.
# The values add to the kerning in the lookups above.
lookup CollisionKern {
    lookupflag 0;
    pos A longs 46;
    pos Aacute longs 46;
    pos Abreve longs 46;
    pos Acircumflex longs 46;
    pos Adieresis longs 46;
    pos Agrave longs 46;
    pos Amacron longs 46;
    pos Aring longs 46;
    pos Atilde longs 46;
    pos K longs 39;
    pos L longs 22;
    pos Lacute longs 22;
    pos Lcaron longs 22;
    pos Lslash longs 21;
    pos R longs 58;
    pos Racute longs 58;
    pos Rcaron longs 58;
    pos X longs 40;
    pos ampersand longs 57;
    pos emdash longs 11;
    pos endash longs 10;
    pos k longs 85;
    pos kgreenlandic longs 74;
